# Server Desktop UI lokal
HOST=127.0.0.1
PORT=3456

# Batas pemrosesan media (menjaga stiker tetap aman & tidak error di WhatsApp)
MAX_DURATION_SECONDS=10
MAX_INPUT_SIZE_MB=20
MAX_CONCURRENT_JOBS=2
PROCESSING_TIMEOUT_MS=45000

# Watermark default stiker (nama paket selalu diisi user di UI, author selalu Adin)
STICKER_AUTHOR=Adin
STICKER_CROP_MODE=center

# Logging (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

# Path FFmpeg/FFprobe (kosongkan untuk otomatis pakai ffmpeg-static/ffprobe-static)
FFMPEG_PATH=
FFPROBE_PATH=
