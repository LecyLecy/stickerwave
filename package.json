{
  "name": "stickerwave",
  "version": "1.0.0",
  "description": "Stickerwave — Desktop Studio UI untuk membuat & mengirim WhatsApp Native Audio Sticker langsung ke chat pribadi",
  "type": "module",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/LecyLecy/stickerwave.git"
  },
  "scripts": {
    "start": "node src/index.js",
